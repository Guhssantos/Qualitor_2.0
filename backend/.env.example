# Ambiente
NODE_ENV=development
PORT=4000

# Banco de dados (SQLite em desenvolvimento). Ex. PostgreSQL:
# DATABASE_URL="postgresql://user:senha@localhost:5432/qualitor?schema=public"
DATABASE_URL="file:./dev.db"

# Segurança — GERE VALORES ALEATÓRIOS LONGOS (ex.: openssl rand -hex 48)
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
BCRYPT_ROUNDS=10

# Origem(ns) do frontend permitidas pelo CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:5173

# Anexos
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=15

# Primeiro administrador (usado por "npm run create-admin" e pelo seed)
ADMIN_NAME="Administrador"
ADMIN_EMAIL=admin@empresa.com
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Seed com dados de demonstração (usuários, chamados de exemplo)
SEED_DEMO=true
DEMO_PASSWORD=

# Jobs (SLA / encerramento automático) — intervalo em segundos
JOBS_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# Integrações futuras (deixe em branco para desativar)
# ---------------------------------------------------------------------------
AI_PROVIDER=rule-based          # rule-based | azure-openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

NOTIFY_CHANNELS=                # ex.: email,teams,whatsapp,telegram
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TEAMS_WEBHOOK_URL=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
TELEGRAM_BOT_TOKEN=
